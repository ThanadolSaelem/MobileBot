<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ backup/restore.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include pet configuration -->
        <include domain="file" path="config.ini" />

        <!-- Exclude sensitive or device-specific data -->
        <exclude domain="sharedpref" path="device.xml" />
        <exclude domain="database" path="." />
        <exclude domain="cache" path="." />
    </cloud-backup>

    <device-transfer>
        <!-- Allow pet state transfer between devices -->
        <include domain="file" path="config.ini" />

        <!-- Exclude device-specific data -->
        <exclude domain="sharedpref" path="device.xml" />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
